# Copy this file to .env and fill in your values
# cp .env.example .env

# Microsoft Foundry — Cohere Embed endpoint
# base_url = Target URI up to /providers/cohere (exclude /v2/embed)
EMBED_MODEL=Cohere-Embed-V5-Pro
EMBED_BASE_URL=https://<your-embed-endpoint>.services.ai.azure.com/providers/cohere
EMBED_API_KEY=<your-embed-api-key>

# Microsoft Foundry — Cohere Rerank endpoint
# base_url = Target URI up to /providers/cohere (exclude /v2/rerank)
RERANK_MODEL=Cohere-rerank-v5-pro
RERANK_BASE_URL=https://<your-rerank-endpoint>.services.ai.azure.com/providers/cohere
RERANK_API_KEY=<your-rerank-api-key>

# Microsoft Foundry — Cohere Parse endpoint
# base_url = Target URI up to /providers/cohere (exclude /v2/parse)
PARSE_MODEL=Cohere-parse-v5
PARSE_BASE_URL=https://<your-parse-endpoint>.services.ai.azure.com/providers/cohere
PARSE_API_KEY=<your-parse-api-key>

# ChromaDB storage path (default is fine)
CHROMA_DB_PATH=./chroma_db