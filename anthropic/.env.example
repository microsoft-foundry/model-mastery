# Claude on Microsoft Foundry
FOUNDRY_ENDPOINT="https://<your-resource>.services.ai.azure.com/anthropic"
FOUNDRY_API_KEY="<your-api-key>"
FOUNDRY_MODEL_DEPLOYMENT="claude-sonnet-5"
FOUNDRY_HAIKU_DEPLOYMENT="claude-haiku-4-5"

# Cupcake Store MCP server: the shared hosted server (SETUP.md, step 3)
CUPCAKE_MCP_URL="https://<cupcake-mcp-host>/mcp/"

# Lab 1, Module 1.3: the shop's knowledge base in Foundry IQ (Azure AI Search)
# A query key, never the admin key. Built with foundry-iq/README.md (SETUP.md, step 4)
AZURE_SEARCH_ENDPOINT="https://<service>.search.windows.net"
AZURE_SEARCH_QUERY_KEY="<query key>"
KNOWLEDGE_BASE_NAME="cupcake-store-kb"

# Lab 2, Module 2.3: tracing (from the Application Insights resource)
ENABLE_OTEL="0"
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Lab 2, Module 2.4: evaluations
# Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=""
# Eval endpoint connection name (workshop: pre-created; on your own: eval-endpoint/README.md)
EVAL_ENDPOINT_CONNECTION="mm-eval-endpoint"

# Module 2.4b only: creating the eval endpoint connection (eval-endpoint/README.md)
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP=""
FOUNDRY_ACCOUNT_NAME=""
FOUNDRY_PROJECT_NAME=""
EVAL_ENDPOINT_URL=""
EVAL_ENDPOINT_API_KEY=""
