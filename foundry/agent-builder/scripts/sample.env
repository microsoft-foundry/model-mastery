# Optional overrides for provision.sh / setenv.sh.
#
# You do NOT need this file for the normal flow — just run ./provision.sh (fresh
# infra) or ./setenv.sh (existing resource group) and it creates ../src/.env for
# you. This file only lists values you can OVERRIDE. Export one before running:
#
#   export AZURE_LOCATION=westus3
#   ./provision.sh
#
# Or source a copy first:  set -a; source sample.env; set +a; ./provision.sh

# Which subscription to deploy into. Leave blank to use your current `az` login.
AZURE_SUBSCRIPTION_ID=

# Where to create resources (provision path only). A region with the models.
AZURE_LOCATION=eastus2

# Resource group. provision.sh creates it; setenv.sh reads from it (so you can
# skip its prompt). Project + Foundry resource names apply to the provision path.
AZURE_RESOURCE_GROUP=rg-model-mastery
AZURE_AI_PROJECT_NAME=foundry-workshop
# Leave blank to auto-generate a unique Foundry (AI Services) resource name.
AZURE_AI_ACCOUNT_NAME=

# Capacity (thousands of tokens/min) for each text deployment.
SKU_CAPACITY=60

# Written into ../src/.env; override only if you renamed the agent or its model
# deployment. Defaults: gpt-5.4 and trailmate.
# TRAILMATE_MODEL_DEPLOYMENT=gpt-5.4
# TRAILMATE_AGENT_NAME=trailmate

# The scripts write ../src/.env (used by every lab) with these keys:
#   FOUNDRY_PROJECT_ENDPOINT, TRAILMATE_MODEL_DEPLOYMENT, TRAILMATE_AGENT_NAME,
#   APPLICATIONINSIGHTS_CONNECTION_STRING, AZURE_SUBSCRIPTION_ID,
#   AZURE_RESOURCE_GROUP, AZURE_AI_ACCOUNT_NAME, AZURE_AI_PROJECT_NAME,
#   AZURE_LOCATION
# Models deployed on the provision path: gpt-5.4, gpt-5.4-mini, model-router,
# MAI-Image-2.5-Pro (and optionally claude-sonnet-4-6, claude-haiku-4-5).
